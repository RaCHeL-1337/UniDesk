@model UniDesk.Web.DTOs.CreateTicketRequest

@{
    ViewData["Title"] = "Nowe zgloszenie";
}

<style>
    .ticket-create-page {
        background: #fff;
        max-width: 640px;
    }

    .ticket-create-header {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin-bottom: 16px;
    }

    .ticket-create-header h1 {
        margin: 0;
    }

    .ticket-create-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-start;
        margin-top: 16px;
    }

    .ticket-create-page .form-control {
        border: 1px solid #222;
        border-radius: 0;
        box-shadow: none;
        font-size: 16px;
    }

    .ticket-create-page textarea {
        min-height: 110px;
    }

    .ticket-create-page .plain-button {
        background: #fff;
        border: 1px solid #111;
        border-radius: 0;
        color: #111;
        display: inline-block;
        padding: 5px 12px;
        text-decoration: none;
    }

    .ticket-create-page .plain-button:hover,
    .ticket-create-page .plain-button:focus {
        background: #f2f2f2;
        color: #111;
    }

    @@media (max-width: 700px) {
        .ticket-create-header,
        .ticket-create-actions {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

<div class="ticket-create-page">
    <div class="ticket-create-header">
        <h1>Nowe zgloszenie</h1>
        <a asp-controller="Tickets" asp-action="Index">Powrot do listy</a>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="ticket-create-actions">
            <button type="submit" class="plain-button">Dodaj zgloszenie</button>
            <a asp-controller="Tickets" asp-action="Index" class="plain-button">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
