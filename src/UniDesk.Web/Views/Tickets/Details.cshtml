@model UniDesk.Web.Models.Ticket
@using UniDesk.Web.Data

@{
    var statusClass = Model.Status switch
    {
        UniDesk.Web.Models.TicketStatus.New => "ticket-status-new",
        UniDesk.Web.Models.TicketStatus.InProgress => "ticket-status-progress",
        UniDesk.Web.Models.TicketStatus.Closed => "ticket-status-closed",
        _ => "ticket-status-unknown"
    };
}

<div class="unidesk-page">
    <h1>Szczegoly zgloszenia</h1>

    <table class="ticket-detail-grid">
        <tbody>
            <tr>
                <th>Id</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Tytul</th>
                <td>@Model.Title</td>
            </tr>
            <tr>
                <th>Opis</th>
                <td>@Model.Description</td>
            </tr>
            <tr>
                <th>Status</th>
                <td><span class="ticket-status @statusClass">@Model.Status</span></td>
            </tr>
            <tr>
                <th>Data</th>
                <td>@Model.CreatedAt</td>
            </tr>
        </tbody>
    </table>

@if (TempData["StatusMessage"] != null)
{
    <p class="text-success">@TempData["StatusMessage"]</p>
}

@if (TempData["StatusError"] != null)
{
    <p class="text-danger">@TempData["StatusError"]</p>
}

@if (Model.Status == UniDesk.Web.Models.TicketStatus.Closed)
{
    <p>Zgloszenie jest zamkniete. Status nie moze byc zmieniony.</p>
}
else
{
    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="plain-panel ticket-status-form">
        @Html.AntiForgeryToken()

        <div>
            <label for="Status">Zmien status</label>
            <select id="Status" name="Status" class="form-select">
                <option value="New" selected="@(Model.Status == UniDesk.Web.Models.TicketStatus.New)">New</option>
                <option value="InProgress" selected="@(Model.Status == UniDesk.Web.Models.TicketStatus.InProgress)">InProgress</option>
                <option value="Closed" selected="@(Model.Status == UniDesk.Web.Models.TicketStatus.Closed)">Closed</option>
            </select>
        </div>

        <button type="submit" class="plain-button">Zapisz status</button>
    </form>
}

<div class="plain-actions">
    <a asp-action="Index" class="plain-button">Powrot</a>

    @if (User.IsInRole(AppRoles.Admin))
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="plain-button">Usun zgloszenie</button>
        </form>
    }
</div>
</div>
