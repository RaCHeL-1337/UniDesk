@model List<UniDesk.Web.DTOs.TicketListDto>

@{
    ViewData["Title"] = "Lista zgłoszeń";
}

<h1>Lista zgłoszeń</h1>

<p>
    <a asp-controller="Tickets" asp-action="Create" class="btn btn-primary">
        Dodaj nowe zgłoszenie
    </a>
</p>

<p>Liczba wszystkich zgłoszeń: @ViewBag.TotalCount</p>

<form method="get" class="mb-3 d-flex gap-2">

    <select name="status" class="form-select">
        <option value="">Wszystkie</option>
        <option value="New">New</option>
        <option value="InProgress">InProgress</option>
        <option value="Closed">Closed</option>
    </select>

    <select name="sortOrder" class="form-select">
        <option value="desc">Najnowsze</option>
        <option value="asc">Najstarsze</option>
    </select>

    <input type="number" name="pageSize" value="5" min="1" class="form-control" />

    <button type="submit" class="btn btn-primary">
        Filtruj
    </button>

</form>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Tytuł</th>
            <th>Status</th>
            <th>Data utworzenia</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in Model)
        {
            <tr>
                <td>@ticket.Id</td>

                <td>@ticket.Title</td>

                <td>@ticket.Status</td>

                <td>@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-action="Index" asp-route-page="1" class="btn btn-outline-primary">1</a>
    <a asp-action="Index" asp-route-page="2" class="btn btn-outline-primary">2</a>
    <a asp-action="Index" asp-route-page="3" class="btn btn-outline-primary">3</a>
</div>