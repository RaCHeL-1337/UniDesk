@model List<UniDesk.Web.DTOs.TicketListDto>

@{
    ViewData["Title"] = "Lista zgloszen";
}

<style>
    .tickets-page {
        background: #fff;
    }

    .tickets-toolbar {
        align-items: center;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .tickets-toolbar h1 {
        margin: 0;
    }

    .tickets-filter {
        align-items: center;
        border: 1px solid #222;
        display: inline-grid;
        gap: 7px;
        grid-template-columns: minmax(160px, 340px) 125px 125px 90px auto;
        margin-bottom: 14px;
        padding: 8px;
    }

    .tickets-filter label {
        color: #222;
        display: block;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .tickets-filter .form-control,
    .tickets-filter .form-select {
        border: 1px solid #222;
        border-radius: 0;
        box-shadow: none;
        font-size: 15px;
        min-height: 32px;
        padding: 3px 8px;
    }

    .tickets-page .plain-button {
        background: #fff;
        border: 1px solid #111;
        border-radius: 0;
        color: #111;
        display: inline-block;
        padding: 5px 12px;
        text-decoration: none;
    }

    .tickets-page .plain-button:hover,
    .tickets-page .plain-button:focus {
        background: #f2f2f2;
        color: #111;
    }

    .tickets-count {
        color: #666;
        margin-bottom: 10px;
    }

    .tickets-pagination {
        margin-top: 14px;
    }

    @@media (max-width: 900px) {
        .tickets-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .tickets-filter {
            justify-content: stretch;
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="tickets-page">
    <div class="tickets-toolbar">
        <div>
            <h1>Lista zgloszen</h1>
            <div class="tickets-count">Liczba wszystkich zgloszen: @ViewBag.TotalCount</div>
        </div>

        <a asp-controller="Tickets" asp-action="Create" class="plain-button">Dodaj nowe zgloszenie</a>
    </div>

    <form method="get" class="tickets-filter">
        <div>
            <label for="search">Szukaj</label>
            <input id="search" type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Szukaj po tytule" />
        </div>

        <div>
            <label for="status">Status</label>
            <select id="status" name="status" class="form-select">
                <option value="">Wszystkie</option>
                <option value="New" selected="@(ViewBag.Status == "New")">New</option>
                <option value="InProgress" selected="@(ViewBag.Status == "InProgress")">InProgress</option>
                <option value="Closed" selected="@(ViewBag.Status == "Closed")">Closed</option>
            </select>
        </div>

        <div>
            <label for="sortOrder">Sort</label>
            <select id="sortOrder" name="sortOrder" class="form-select">
                <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Najnowsze</option>
                <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Najstarsze</option>
            </select>
        </div>

        <div>
            <label for="pageSize">Na stronie</label>
            <input id="pageSize" type="number" name="pageSize" value="@ViewBag.PageSize" min="1" class="form-control" />
        </div>

        <button type="submit" class="plain-button">Filtruj</button>
    </form>

    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Tytul</th>
                <th>Status</th>
                <th>Data utworzenia</th>
                <th>Akcja</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Id</td>
                    <td>@ticket.Title</td>
                    <td>@ticket.Status</td>
                    <td>@ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a asp-action="Details" asp-route-id="@ticket.Id">Szczegoly</a></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="tickets-pagination">
        Strony:
        <a asp-action="Index" asp-route-page="1">1</a>
        <a asp-action="Index" asp-route-page="2">2</a>
        <a asp-action="Index" asp-route-page="3">3</a>
    </div>
</div>
